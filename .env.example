FLASK_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autogate_dev

# Security
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-in-production

# Service URLs
LPR_SERVICE_URL=http://localhost:5001
RASA_SERVER_URL=http://localhost:5005

# Gate control
GATE_HOST=127.0.0.1
GATE_PORT=9999

# Parking/system settings
TOTAL_PARKING_SPOTS=100
UPLOAD_FOLDER=/tmp/autogate_uploads
CAMERA_FEED_URL=http://localhost:5001/camera/feed

# Chatbot knowledge base — local text/PDF search is default (fast, no API key needed)
# Set USE_RAG=true or USE_GEMINI=true only if you want slower AI-enhanced answers
GOOGLE_API_KEY=
USE_RAG=false
USE_GEMINI=false
